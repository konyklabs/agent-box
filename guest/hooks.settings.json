{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "/opt/agent-box/guest/channel.sh hook SessionStart", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "/opt/agent-box/guest/channel.sh hook UserPromptSubmit", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "/opt/agent-box/guest/hook-event.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "/opt/agent-box/guest/hook-event.sh" },
          { "type": "command", "command": "/opt/agent-box/guest/channel.sh hook PostToolUse", "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "/opt/agent-box/guest/hook-event.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/opt/agent-box/guest/hook-event.sh" },
          { "type": "command", "command": "/opt/agent-box/guest/channel.sh hook Stop", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "/opt/agent-box/guest/hook-event.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "/opt/agent-box/guest/hook-event.sh" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "/opt/agent-box/guest/hook-event.sh" }
        ]
      }
    ]
  }
}
