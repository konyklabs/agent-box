    leftovers)      shift; cmd_leftovers "$@" ;;
    # Not in the usage text, like watch-run: a hook calls it, nobody types it.
    watch-run)      shift; cmd_watch_run "$@" ;;
    channel-hook)   shift; cmd_channel_hook "$@" ;;
    plugins)        shift; cmd_plugins "$@" ;;
    update)         shift; cmd_update "$@" ;;
