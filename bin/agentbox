    sessions)       shift; cmd_sessions "$@" ;;
    run)            shift; cmd_run "$@" ;;
    resume)         shift; cmd_resume "$@" ;;
    ask)            shift; cmd_ask "$@" ;;
    learnings)      shift; cmd_learnings "$@" ;;
    channel)        shift; cmd_channel "$@" ;;
    handoff)        shift; cmd_handoff "$@" ;;
    request)        shift; cmd_request "$@" ;;
    keepalive)      shift; cmd_keepalive "$@" ;;
    watchdog)       shift; cmd_watchdog "$@" ;;
    runs)           shift; cmd_runs "$@" ;;
    logs)           shift; cmd_logs "$@" ;;
